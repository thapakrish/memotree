# Optional for private local development. The app also prompts for this in the browser.
# Do not use this for public/static deployments; Vite embeds client env vars in built JavaScript.
VITE_GEMINI_API_KEY=

# Optional Ollama defaults. These are local connection settings, not secrets.
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=
